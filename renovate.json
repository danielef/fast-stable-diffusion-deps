{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "npm": {
    "rangeStrategy": "pin"
  },
  "pip_requirements": {
    "fileMatch": ["^requirements/.*\\.txt$"],
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Packages pinned below Colab's version due to Forge API compatibility — require manual review before merging",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["numpy", "gradio", "transformers", "diffusers", "accelerate", "protobuf", "Pillow", "open-clip-torch"],
      "labels": ["downgrade-override"],
      "automerge": false,
      "schedule": ["every weekend"]
    },
    {
      "description": "numpy must stay on 1.x — NumPy 2.x changed the C extension ABI and breaks Forge's compiled deps",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["numpy"],
      "allowedVersions": ">=1.0.0,<2.0.0"
    },
    {
      "description": "gradio must stay on 4.x — Forge uses the 4.x UI API",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["gradio"],
      "allowedVersions": ">=4.0.0,<5.0.0"
    },
    {
      "description": "Pillow must stay below 11.0 — gradio 4.x requires pillow<11.0",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["Pillow"],
      "allowedVersions": ">=8.0.0,<11.0.0"
    },
    {
      "description": "transformers must stay on 4.x — Forge relies on the 4.x API",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["transformers"],
      "allowedVersions": ">=4.0.0,<5.0.0"
    },
    {
      "description": "protobuf must stay on 3.x — Forge hardcodes the 3.x API; protobuf 4+ is a breaking rewrite",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["protobuf"],
      "allowedVersions": ">=3.0.0,<4.0.0"
    },
    {
      "description": "accelerate must stay on 0.x — Forge depends on 0.x API; v1 introduced breaking changes",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["accelerate"],
      "allowedVersions": ">=0.0.0,<1.0.0"
    },
    {
      "description": "open-clip-torch must stay on 2.x — v3 may introduce breaking API changes incompatible with Forge",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["open-clip-torch"],
      "allowedVersions": ">=2.0.0,<3.0.0"
    },
    {
      "description": "Forge-specific packages not in Colab — safe to automerge patch/minor updates",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": [
        "GitPython",
        "blendmodes",
        "clean-fid",
        "diskcache",
        "facexlib",
        "inflection",
        "jsonmerge",
        "kornia",
        "omegaconf",
        "piexif",
        "resize-right",
        "spandrel",
        "spandrel-extra-arches",
        "tomesd",
        "torchdiffeq",
        "torchsde",
        "pillow-avif-plugin",
        "gradio_rangeslider",
        "gradio_imageslider",
        "loadimg",
        "setuptools",
        "audioop-lts"
      ],
      "automerge": true,
      "automergeType": "branch",
      "schedule": ["every weekend"]
    },
    {
      "description": "pip dependency updates change the blob — use fix(deps) to trigger a patch release",
      "matchManagers": ["pip_requirements"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "GitHub Actions updates only affect CI, not the blob — use chore(ci)",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "npm updates are toolchain-only, not the blob — use chore(deps)",
      "matchManagers": ["npm"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "pytorch_lightning is pinned hard by Forge — updates need a manual Forge compatibility test",
      "matchManagers": ["pip_requirements"],
      "matchDepNames": ["pytorch_lightning"],
      "enabled": false
    },
    {
      "description": "Python version must match Colab exactly — update manually following the process in README.md",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Ubuntu runner must match Colab exactly — update manually following the process in README.md",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["ubuntu"],
      "enabled": false
    }
  ]
}
